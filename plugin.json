  "author": {
    "name": "Wavegrain",
    "email": "support@wavegrain.com",
    "url": "https://wavegrain.com"
  },
  "homepage": "https://wavegrain.com/mcp",
  "repository": "https://github.com/wavegrain/wavegrain-mcp",
  "license": "MIT",
  "keywords": [
    "tiktok",
    "instagram",
    "carousel",
    "slideshow",
    "social-media",
    "mcp"
  ],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "wavegrain": {
          "trust": "untrusted"
        }
      }
    }
